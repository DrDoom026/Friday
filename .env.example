APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Filesystem sandbox (PART 4). Colon-separated list of absolute roots.
FS_ALLOWED_ROOTS=~/firday/workspace
FS_MAX_READ_BYTES=5242880
FS_MAX_WRITE_BYTES=5242880
FS_MAX_COPY_BYTES=52428800
FS_MAX_LIST_ENTRIES=1000
FS_MAX_SEARCH_RESULTS=500
FS_MAX_SEARCH_DEPTH=12
