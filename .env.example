APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Filesystem sandbox (PART 4). Colon-separated list of absolute roots.
# Created at startup if missing; the app refuses to boot if it cannot be used.
# Docker only: docker-compose.yml overrides this with /data/workspace, because
# ~ expands to /root in the container and /root is a protected system path.
# Set FS_HOST_ROOT to move the host side of that bind mount.
FS_ALLOWED_ROOTS=~/firday/workspace
#FS_HOST_ROOT=/home/pi/firday/workspace
FS_MAX_READ_BYTES=5242880
FS_MAX_WRITE_BYTES=5242880
FS_MAX_COPY_BYTES=52428800
FS_MAX_LIST_ENTRIES=1000
FS_MAX_SEARCH_RESULTS=500
FS_MAX_SEARCH_DEPTH=12

# Memory vault (PART 8). A second sandboxed root, separate from the workspace.
# Syncthing mirrors this directory to laptop/phone - unrelated to FIRDAY's code.
# Docker only: docker-compose.yml overrides this with /data/vault, same reason
# as FS_ALLOWED_ROOTS above. Set FS_VAULT_HOST_ROOT to move the host side.
FS_VAULT_ROOT=~/firday/vault
#FS_VAULT_HOST_ROOT=/home/pi/firday/vault

# System tools (PART 6).
# DOCKER_SOCKET is where the docker.* tools look for the engine. The compose
# file bind-mounts the host's socket to the same path inside the container.
DOCKER_SOCKET=/var/run/docker.sock
SYSTEM_COMMAND_TIMEOUT_SECONDS=10
SYSTEM_GIT_TIMEOUT_SECONDS=120
SYSTEM_MAX_PROCESSES=500
SYSTEM_MAX_LOG_LINES=500
SYSTEM_MAX_PING_COUNT=10

# Hybrid LLM layer (PART 9). FIRDAY_PLANNER=mock keeps the Part 1 mock planner
# (default, no external services needed). Set to "llm" only once Ollama and
# OmniRoute are actually installed and verified running - see the handoff doc.
FIRDAY_PLANNER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OMNIROUTE_BASE_URL=http://localhost:3333
OMNIROUTE_MODEL=auto
#OMNIROUTE_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=4000
LLM_MEMORY_TOP_K=3
